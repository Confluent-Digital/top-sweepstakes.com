# ------------------------------------------------------------------ Application
APP_NAME=top-sweepstakes
APP_ENV=development
APP_DEBUG=true
APP_URL=https://top-sweepstakes.com
APP_DOMAIN=top-sweepstakes.com
TZ=America/New_York

# Cle utilisee pour les signatures internes (uid d'offre, jetons de sortie).
# Generer avec : php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
APP_SECRET=

# ------------------------------------------------------------------ Base de donnees
DB_ADAPTER=mysql
DB_HOST=topsweepstakes_mariadb
DB_PORT=3306
DB_NAME=bd_top_sweepstakes
DB_USERNAME=topsweepstakes
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_CHARSET=utf8mb4

# ------------------------------------------------------------------ Docker
# Ports exposes sur 127.0.0.1 uniquement (acces SQLyog via tunnel SSH sur DOCKER_MYSQL_PORT)
DOCKER_NGINX_PORT=2032
DOCKER_PHP_PORT=7032
DOCKER_MYSQL_PORT=3332
# Donnees MariaDB. Un chemin ABSOLU hors de l'arborescence du projet est
# preferable — c'est ce que fait la production
# (ex. /data/docker_mysql/top-sweepstakes.com) : le repertoire appartient au
# mysql de l'image (999:999), et le laisser sous le projet en fait un piege a
# chaque manipulation de droits, ou un `chown -R` sur le depot le retire a
# MariaDB qui refuse alors de demarrer.
DOCKER_DB_DIRECTORY=./.docker/data/mariadb
UID=1000
GID=1000

# ------------------------------------------------------------------ Regie d'affiliation (cdflow)
# Base du lien de sortie des offres display. Le lien final est construit par
# App\Modules\Offers\Services\OfferLinkBuilder, jamais en dur dans un gabarit.
AFFILIATE_TRACKING_BASE=https://www.cdflow4.com/tracking/cpc.php
# Identifiant du site (parametre "ids") attribue par la regie.
AFFILIATE_SITE_IDS=

# Flux de reporting (revenus). Identifiants JAMAIS en dur dans le code.
AFFILIATE_REPORT_URL=https://plateforme.confluent-digital.com/flux/reporting.php
AFFILIATE_REPORT_LOGIN=
AFFILIATE_REPORT_PASSWORD=

# ------------------------------------------------------------------ Contenus legaux
# Hote interne du service de contenus legaux, joignable via le reseau
# comparer-changer-network. Prioritaire : pas de sortie Internet, pas de TLS.
LEGALS_INTERNAL_URL=http://legalscd_nginx
# Repli public, utilise si l'hote interne ne repond pas.
LEGALS_BASE_URL=https://legals.confluent-digital.com
LEGALS_LANG=en
LEGALS_CACHE_TTL=3600

# ------------------------------------------------------------------ Verification email / telephone (lot 3)
LEAD_VERIFY_PROVIDER=
LEAD_VERIFY_API_KEY=
