{% extends 'admin/layout.html.twig' %}
{% block title %}Tableau de bord{% endblock %}

{% block content %}
    <h1 class="h4 mb-4">Tableau de bord</h1>

    <div class="row g-3 mb-4">
        {% set cards = [
            {label: "Participations aujourd'hui", value: entries_today},
            {label: 'Participations (30 jours)', value: entries_30d},
            {label: "Impressions aujourd'hui", value: impressions_today},
            {label: "Clics aujourd'hui", value: clicks_today}
        ] %}
        {% for card in cards %}
            <div class="col-6 col-lg-3">
                <div class="card card-body">
                    <div class="text-muted small">{{ card.label }}</div>
                    <div class="fs-3">{{ card.value|number_format(0, ',', ' ') }}</div>
                </div>
            </div>
        {% endfor %}
    </div>

    <div class="card card-body mb-4">
        <div class="text-muted small">Taux de clic du jour</div>
        {# « Vide » ne se lit pas « zero » : sans impression, il n'y a pas de
           taux, et l'ecran doit le dire plutot qu'afficher 0 %. #}
        <div class="fs-4">
            {% if ctr_today is null %}
                <span class="empty">aucune impression aujourd'hui</span>
            {% else %}
                {{ ctr_today }} %
            {% endif %}
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card">
                <div class="card-header">Participations par jour (30 derniers jours)</div>
                {% if by_day is empty %}
                    <div class="card-body empty">Aucune participation sur la periode.</div>
                {% else %}
                    <table class="table table-sm mb-0">
                        <thead><tr><th>Jour</th><th class="text-end">Participations</th></tr></thead>
                        <tbody>
                        {% for row in by_day %}
                            <tr><td>{{ row.jour }}</td><td class="text-end">{{ row.nb }}</td></tr>
                        {% endfor %}
                        </tbody>
                    </table>
                {% endif %}
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card">
                <div class="card-header">Sources (30 derniers jours)</div>
                {% if by_source is empty %}
                    <div class="card-body empty">Aucune participation sur la periode.</div>
                {% else %}
                    <table class="table table-sm mb-0">
                        <thead><tr><th>subid</th><th class="text-end">Participations</th></tr></thead>
                        <tbody>
                        {% for row in by_source %}
                            <tr><td>{{ row.source }}</td><td class="text-end">{{ row.nb }}</td></tr>
                        {% endfor %}
                        </tbody>
                    </table>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
