<form method="get" class="card card-body mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-auto">
            <label class="form-label" for="from">Du</label>
            <input type="date" class="form-control form-control-sm" id="from" name="from" value="{{ from }}">
        </div>
        <div class="col-auto">
            <label class="form-label" for="to">Au</label>
            <input type="date" class="form-control form-control-sm" id="to" name="to" value="{{ to }}">
        </div>
        <div class="col-auto">
            <button class="btn btn-primary btn-sm" type="submit">Afficher</button>
        </div>
    </div>
</form>

<div class="row g-3 mb-3">
    {% set summary = [
        {label: 'Impressions', value: totals.impressions|number_format(0, ',', ' ')},
        {label: 'Clics', value: totals.clicks|number_format(0, ',', ' ')},
        {label: 'Revenu', value: '$' ~ totals.revenue|number_format(2)},
        {label: 'Taux de clic', value: totals.ctr is null ? null : totals.ctr ~ ' %'},
        {label: 'eCPM', value: totals.ecpm is null ? null : '$' ~ totals.ecpm|number_format(4)}
    ] %}
    {% for card in summary %}
        <div class="col-6 col-lg">
            <div class="card card-body py-2">
                <div class="text-muted small">{{ card.label }}</div>
                <div class="fs-5">
                    {# Sans impression, il n'y a pas de taux : le dire, plutot
                       qu'afficher 0 % qui se lirait comme une contre-performance. #}
                    {{ card.value ?? '<span class="empty">aucune donnée</span>'|raw }}
                </div>
            </div>
        </div>
    {% endfor %}
</div>

<p class="text-muted small">
    Les totaux portent sur la période et le filtre affichés, pas sur la page.
</p>
