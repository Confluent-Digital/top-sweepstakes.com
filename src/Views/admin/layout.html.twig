<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Administration{% endblock %} — {{ app_name }}</title>
    <meta name="robots" content="noindex, nofollow">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <style>
        body { background: #f4f6fa; }
        .navbar-brand { font-weight: 700; }
        .table-sm td, .table-sm th { vertical-align: middle; }
        .badge-status-draft { background: #6c757d; }
        .badge-status-published { background: #198754; }
        .badge-status-paused { background: #fd7e14; }
        .badge-status-ended { background: #495057; }
        .empty { color: #6c757d; font-style: italic; }
        code.url-preview { word-break: break-all; display: block; }
    </style>
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
    <div class="container-fluid">
        <a class="navbar-brand" href="/admin">{{ app_name }}</a>
        <div class="navbar-nav me-auto">
            <a class="nav-link" href="/admin">Tableau de bord</a>
            <a class="nav-link" href="/admin/sweepstakes">Concours</a>
            <a class="nav-link" href="/admin/offers">Offres</a>
            <a class="nav-link" href="/admin/leads">Participants</a>
            <a class="nav-link" href="/admin/stats/offers">Stats offres</a>
            <a class="nav-link" href="/admin/stats/sources">Stats sources</a>
        </div>
        <a class="nav-link text-light" href="/admin/logout">Deconnexion</a>
    </div>
</nav>

<main class="container-fluid pb-5">
    {% block content %}{% endblock %}
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{% block scripts %}{% endblock %}
</body>
</html>
