{% extends 'front/layout.html.twig' %}

{% block title %}{{ title }} — {{ app_name }}{% endblock %}

{% block content %}
    <article class="legal-page">
        <h1>{{ title }}</h1>

        {% if done %}
            <p class="alert" role="status">{{ success_message }}</p>
        {% else %}
            <p>Enter the email address you would like to remove from our mailings.</p>

            {% if error %}<p class="alert alert-error" role="alert">{{ error }}</p>{% endif %}

            <form method="post" action="/unsubscribe" class="entry-form">
                <div class="field{% if error %} field--error{% endif %}">
                    <label for="email">Email address</label>
                    <input type="email" id="email" name="email" value="{{ email }}"
                           inputmode="email" autocomplete="email" required>
                </div>
                <button type="submit" class="btn btn-primary btn-block">Unsubscribe me</button>
            </form>
        {% endif %}
    </article>
{% endblock %}
