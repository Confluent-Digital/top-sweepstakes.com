{% extends 'front/layout.html.twig' %}

{% block title %}{{ site.site_meta_title|default('Free sweepstakes — ' ~ site.site_name) }}{% endblock %}
{% block description %}{{ site.site_meta_description|default(site.site_intro) }}{% endblock %}
{# L'accueil est la seule page du site qui a vocation à être indexée. #}
{% block robots %}index, follow{% endblock %}
{% block main_class %} site-main--wide{% endblock %}

{% block content %}
    <section class="home-head">
        <h1 class="home-title">{{ site.site_tagline }}</h1>
        <p class="home-sub">{{ site.site_intro }}</p>

        <ul class="home-trust">
            <li>{% include 'front/partials/icon.html.twig' with {name: 'gift'} only %} 100% free to enter</li>
            <li>{% include 'front/partials/icon.html.twig' with {name: 'lock'} only %} Secure &amp; encrypted</li>
            <li>{% include 'front/partials/icon.html.twig' with {name: 'clock'} only %} Under 2 minutes</li>
        </ul>
    </section>

    <section class="home-section" aria-labelledby="open-sweepstakes">
        <h2 class="section-heading" id="open-sweepstakes">Open sweepstakes</h2>

        {% if sweepstakes is empty %}
            <p class="empty-state">{{ site.site_empty_message }}</p>
        {% else %}
            <ul class="sweepstake-grid">
                {% for item in sweepstakes %}
                    <li class="sweepstake-card">
                        {# Toute la carte est cliquable : une seule cible, large au pouce. #}
                        <a href="/{{ item.sweepstake_slug }}">
                            {% if item.sweepstake_prize_image %}
                                {% include 'front/partials/prize-image.html.twig' with {
                                    src: '/img/sweepstakes/' ~ item.sweepstake_id ~ '/' ~ item.sweepstake_prize_image,
                                    alt: item.sweepstake_prize_title ?: item.sweepstake_name,
                                    width: item.sweepstake_prize_image_width,
                                    height: item.sweepstake_prize_image_height,
                                    ratio_w: 400,
                                    ratio_h: 250,
                                    class: 'sweepstake-card-image'
                                } only %}
                            {% endif %}

                            <span class="sweepstake-card-body">
                                {#
                                    Le badge est dérivé des données — fin proche, affluence,
                                    mise en ligne récente — jamais saisi : un champ « mis en
                                    avant » se remplit une fois puis ne bouge plus, et ment.
                                #}
                                {% if item.badge %}
                                    <span class="badge-pill badge-pill--{{ item.badge }}">
                                        {{- {'ending': 'Ending soon', 'popular': 'Popular', 'new': 'New'}[item.badge] -}}
                                    </span>
                                {% endif %}

                                {% if item.sweepstake_prize_value_usd > 0 %}
                                    <span class="sweepstake-card-value">
                                        ${{ item.sweepstake_prize_value_usd|number_format(0) }}
                                    </span>
                                {% endif %}

                                <span class="sweepstake-card-title">
                                    {{ item.sweepstake_prize_title ?: item.sweepstake_name }}
                                </span>

                                <span class="sweepstake-card-meta">
                                    Free entry · No purchase necessary
                                    {%- if item.days_left is not null and item.days_left >= 0 and item.days_left <= 14 %}
                                        · {{ item.days_left }} day{{ item.days_left == 1 ? '' : 's' }} left
                                    {%- endif %}
                                </span>

                                <span class="btn btn-primary btn-block">Enter now</span>
                            </span>
                        </a>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </section>

    <section class="home-section" aria-labelledby="how-it-works">
        <h2 class="section-heading" id="how-it-works">How it works</h2>
        <ol class="steps">
            {% for step in [
                {title: 'Pick a sweepstake', text: 'Choose the prize you want. Entry is always free.'},
                {title: 'Fill in the form', text: 'It takes under two minutes. No purchase necessary.'},
                {title: 'Browse bonus offers', text: 'Optional partner offers. Skip any you don\'t want.'},
                {title: 'Watch your inbox', text: 'Winners are drawn at random and contacted directly.'}
            ] %}
                <li class="step">
                    <span class="step-num">{{ loop.index }}</span>
                    <span class="step-body">
                        <strong>{{ step.title }}</strong>
                        <span>{{ step.text }}</span>
                    </span>
                </li>
            {% endfor %}
        </ol>
    </section>

    <section class="home-section" aria-labelledby="faq">
        <h2 class="section-heading" id="faq">Frequently asked questions</h2>
        {#
            <details> natif : l'accordéon fonctionne sans une ligne de
            JavaScript, et reste ouvrable par la recherche du navigateur.
        #}
        <div class="faq">
            {% for item in [
                {q: 'Do I have to pay to enter?',
                 a: 'No. Entry is completely free and no purchase is necessary. A purchase will not
                     increase your chances of winning.'},
                {q: 'Who can enter?',
                 a: 'Legal residents of the United States who meet the minimum age stated in each
                     sweepstake\'s Official Rules. Some states may be excluded — each sweepstake
                     says which.'},
                {q: 'Do I have to accept the bonus offers?',
                 a: 'No. Your entry is confirmed as soon as you submit the form. The offers shown
                     afterwards are optional, and skipping them changes nothing.'},
                {q: 'How are winners chosen and contacted?',
                 a: 'Winners are selected in a random drawing and contacted using the details
                     provided at entry. Full details are in each sweepstake\'s Official Rules.'},
                {q: 'How do I stop receiving emails?',
                 a: 'Use the unsubscribe link in any email, or the Unsubscribe page linked at the
                     bottom of this site.'}
            ] %}
                <details class="faq-item">
                    <summary>{{ item.q }}</summary>
                    <p>{{ item.a }}</p>
                </details>
            {% endfor %}
        </div>
    </section>
{% endblock %}
