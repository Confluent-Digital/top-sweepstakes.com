{#
    Pictogrammes du tunnel — SVG en ligne, monochromes, à la couleur du texte.

    Pas d'emoji : chaque plateforme en dessine un différent, en couleur, et
    trois pictogrammes bariolés au milieu d'une page sobre se lisent comme une
    décoration plutôt que comme une garantie. Pas de police d'icônes non plus :
    le tunnel ne charge aucune ressource tierce, et ce doit rester vrai.

    Paramètres : name, size (défaut 18).
#}
{% set size = size|default(18) %}
<svg class="ico" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none"
     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
     aria-hidden="true" focusable="false">
    {%- if name == 'lock' -%}
        <rect x="4" y="10.5" width="16" height="10.5" rx="2.5"/><path d="M8 10.5V7a4 4 0 0 1 8 0v3.5"/>
    {%- elseif name == 'clock' -%}
        <circle cx="12" cy="12" r="9"/><path d="M12 7v5.2l3.2 1.9"/>
    {%- elseif name == 'gift' -%}
        <path d="M3 11h18v9a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1z"/><path d="M2 7.5h20V11H2z"/>
        <path d="M12 7.5V21"/><path d="M12 7.5S10.8 3 8.4 3a2.4 2.4 0 0 0 0 4.5z"/>
        <path d="M12 7.5S13.2 3 15.6 3a2.4 2.4 0 0 1 0 4.5z"/>
    {%- elseif name == 'check' -%}
        <circle cx="12" cy="12" r="9"/><path d="M8 12.4l2.6 2.6L16 9.6"/>
    {%- elseif name == 'trophy' -%}
        <path d="M8 3h8v5a4 4 0 0 1-8 0z"/><path d="M8 5H5v2a3 3 0 0 0 3 3"/>
        <path d="M16 5h3v2a3 3 0 0 1-3 3"/><path d="M12 12v4"/><path d="M8.5 21h7l-1-5h-5z"/>
    {%- endif -%}
</svg>
