{#
    Un champ du formulaire, rendu depuis `t_sweepstake_field`.

    Les attributs mobiles (type, inputmode, autocomplete) sont choisis ici : ce
    sont eux qui evitent au visiteur de basculer de clavier a chaque champ.
#}
{% set key = field.sweepstake_field_key %}
{% set label = field.sweepstake_field_label ?: {
    'email': 'Email address',
    'first_name': 'First name',
    'last_name': 'Last name',
    'address': 'Street address',
    'city': 'City',
    'state': 'State',
    'zip': 'ZIP code',
    'phone': 'Phone number',
    'dob': 'Date of birth',
    'gender': 'Gender'
}[key]|default(key) %}

<div class="field{% if error %} field--error{% endif %}">
    <label for="field-{{ key }}">
        {{ label }}{% if not field.sweepstake_field_required %} <span class="optional">(optional)</span>{% endif %}
    </label>

    {% if key == 'state' %}
        <select id="field-{{ key }}" name="{{ key }}" autocomplete="address-level1"
                {% if field.sweepstake_field_required %}required{% endif %}
                {% if error %}aria-invalid="true" aria-describedby="error-{{ key }}"{% endif %}>
            <option value="">Select your state</option>
            {% for code, name in states %}
                <option value="{{ code }}" {% if value == code %}selected{% endif %}>{{ name }}</option>
            {% endfor %}
        </select>

    {% elseif key == 'gender' %}
        <select id="field-{{ key }}" name="{{ key }}"
                {% if field.sweepstake_field_required %}required{% endif %}
                {% if error %}aria-invalid="true" aria-describedby="error-{{ key }}"{% endif %}>
            <option value="">Select</option>
            {% for option, text in {'female': 'Female', 'male': 'Male', 'other': 'Other'} %}
                <option value="{{ option }}" {% if value == option %}selected{% endif %}>{{ text }}</option>
            {% endfor %}
        </select>

    {% else %}
        {% set types = {
            'email': 'email', 'phone': 'tel', 'dob': 'date',
            'zip': 'text', 'address': 'text', 'city': 'text',
            'first_name': 'text', 'last_name': 'text'
        } %}
        {% set modes = {'phone': 'tel', 'zip': 'numeric', 'email': 'email'} %}
        {% set completes = {
            'email': 'email', 'phone': 'tel', 'first_name': 'given-name',
            'last_name': 'family-name', 'address': 'address-line1',
            'city': 'address-level2', 'zip': 'postal-code', 'dob': 'bday'
        } %}

        {#
            Date de naissance : bornes explicites.

            Un `type="date"` sans borne ouvre le selecteur mobile sur la date du
            jour ; atteindre une annee de naissance y demande une trentaine de
            gestes, sur le dernier champ du dernier ecran — c'est la ou l'on perd
            les participants les plus avances dans le tunnel. `max` place le
            selecteur sur l'annee limite d'eligibilite, `min` ecarte les dates
            impossibles. La verification d'age reste faite cote serveur, avec son
            message explicite : ces bornes ne sont qu'un confort de saisie.
        #}
        {% if key == 'dob' %}
            {% set dob_max = 'now'|date_modify('-' ~ (min_age|default(18)) ~ ' years')|date('Y-m-d') %}
            {% set dob_min = 'now'|date_modify('-120 years')|date('Y-m-d') %}
        {% endif %}

        <input type="{{ types[key]|default('text') }}"
               id="field-{{ key }}"
               name="{{ key }}"
               value="{{ value }}"
               {% if modes[key] is defined %}inputmode="{{ modes[key] }}"{% endif %}
               {% if completes[key] is defined %}autocomplete="{{ completes[key] }}"{% endif %}
               {% if key == 'email' %}autocapitalize="off" autocorrect="off" spellcheck="false"{% endif %}
               {% if key == 'zip' %}maxlength="10" pattern="[0-9]{5}(-[0-9]{4})?"{% endif %}
               {% if key in ['dob', 'phone'] %}aria-describedby="hint-{{ key }}{% if error %} error-{{ key }}{% endif %}"{% endif %}
               {% if key == 'dob' %}max="{{ dob_max }}" min="{{ dob_min }}"{% endif %}
               {% if field.sweepstake_field_required %}required{% endif %}
               {% if error and key not in ['dob', 'phone'] %}aria-invalid="true" aria-describedby="error-{{ key }}"{% elseif error %}aria-invalid="true"{% endif %}>

        {# Repli des navigateurs sans `type="date"` : ils rendent un champ texte
           sans indication de format. Le validateur accepte MM/DD/YYYY. #}
        {% if key == 'dob' %}
            <p class="field-hint" id="hint-{{ key }}">MM/DD/YYYY</p>
        {% endif %}

        {#
            Le téléphone est obligatoire et n'est PAS un canal marketing : aucune
            case de consentement téléphonique n'est présentée. Le dire ici, sous
            le champ, au moment où on le demande — et non dans une notice qu'on
            atteint en trois clics — est ce qui rend la collecte loyale.
        #}
        {% if key == 'phone' %}
            <p class="field-hint" id="hint-{{ key }}">
                Used only for Sweepstakes administration, eligibility verification and winner contact.
                Your phone number will not be used by {{ sponsor_name|default('the Sponsor') }} for
                marketing calls or text messages.
            </p>
        {% endif %}
    {% endif %}

    {# L'erreur est affichee AU champ concerne, et la saisie n'est pas perdue. #}
    {% if error %}
        <p class="field-error" id="error-{{ key }}">{{ error }}</p>
    {% endif %}
</div>
