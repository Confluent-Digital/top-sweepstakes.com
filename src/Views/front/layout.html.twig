{#
    Gabarit unique du tunnel, pour TOUS les concours.

    Le thème (couleurs, police) arrive en variables CSS depuis
    `t_sweepstake.theme`. Il n'existe ni feuille de style ni gabarit par
    concours : voir .claude/rules/sweepstakes.md.
#}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ site.site_name|default(app_name) }}{% endblock %}</title>
    <meta name="description" content="{% block description %}{% endblock %}">
    <meta name="theme-color" content="{{ theme.primary|default('#1b4dff') }}">
    {# Trafic payé : le tunnel n'a pas vocation à être indexé. #}
    <meta name="robots" content="{% block robots %}noindex, nofollow{% endblock %}">
    <style>
        :root {
            --color-primary: {{ theme.primary|default('#1b4dff') }};
            --color-accent: {{ theme.accent|default('#ffb020') }};
            --color-bg: {{ theme.background|default('#f6f7fb') }};
            --color-surface: {{ theme.surface|default('#ffffff') }};
            --font-family: {{ theme.font|default('system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif')|raw }};
        }
    </style>
    {% if site.site_favicon|default('') %}
        <link rel="icon" href="/img/site/{{ site.site_favicon }}">
        <link rel="apple-touch-icon" href="/img/site/{{ site.site_favicon }}">
    {% endif %}
    <link rel="stylesheet" href="/dist/css/front.css">
</head>
<body>
<header class="site-header">
    <a class="site-logo" href="/">{{ site.site_name|default(app_name) }}</a>
    <span class="site-badge">
        {% include 'front/partials/icon.html.twig' with {'name': 'lock', 'size': 14} only %}
        Secure &amp; encrypted
    </span>
</header>

<main class="site-main{% block main_class %}{% endblock %}">
    {% block content %}{% endblock %}
</main>

<footer class="site-footer">
    <nav class="footer-links" aria-label="Legal">
        {% if sweepstake is defined and sweepstake %}
            <a href="/{{ sweepstake.sweepstake_slug }}/rules">Official Rules</a>
        {% endif %}
        <a href="/privacy">Privacy Policy</a>
        <a href="/terms">Terms of Service</a>
        <a href="/partners">Marketing Partners</a>
        {# Exigé par le CCPA/CPRA : le lien doit être visible sur chaque page. #}
        <a href="/do-not-sell">Do Not Sell or Share My Personal Information</a>
        <a href="/unsubscribe">Unsubscribe</a>
    </nav>

    {#
        CAN-SPAM : adresse postale physique, sur CHAQUE page.
        Celle du sponsor sur les pages d'un concours, celle du site partout
        ailleurs — sans ce repli, /unsubscribe n'en affichait aucune, alors que
        c'est précisément la page d'atterrissage d'un lien de désinscription.
    #}
    {% if sweepstake is defined and sweepstake and sweepstake.sweepstake_sponsor_address %}
        <p class="footer-address">
            {{ sweepstake.sweepstake_sponsor_name }} — {{ sweepstake.sweepstake_sponsor_address }}
        </p>
    {% elseif site.site_postal_address|default('') %}
        <p class="footer-address">
            {{ site.site_company_name|default(site.site_name) }} — {{ site.site_postal_address }}
        </p>
    {% endif %}

    {% if sweepstake is defined and sweepstake and sweepstake.sweepstake_brand_disclaimer %}
        <p class="footer-disclaimer">{{ sweepstake.sweepstake_brand_disclaimer }}</p>
    {% endif %}

    <p>&copy; {{ "now"|date("Y") }} {{ site.site_name|default(app_name) }}. All rights reserved.</p>
</footer>
{% block scripts %}{% endblock %}
</body>
</html>
